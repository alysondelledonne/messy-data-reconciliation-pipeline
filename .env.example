# Copy to .env and fill in. .env is gitignored; never commit real values.

# Anthropic API key. Needed from Milestone 3 (extraction). CI uses a mock and needs none.
ANTHROPIC_API_KEY=

# Postgres. docker-compose.yml uses these values to create the database.
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pipeline
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://pipeline:change-me@localhost:5432/pipeline
