# Copy to .env and fill in. .env is gitignored; never commit real values.

# Anthropic API key. Needed from Milestone 3 (extraction). CI uses a mock and needs none.
ANTHROPIC_API_KEY=
# Only if your key is NOT scoped to a workspace (the API says so with a 400): the ID of the
# workspace to use, from the Console's Workspaces page (looks like wrkspc_...).
ANTHROPIC_WORKSPACE_ID=

# Postgres. docker-compose.yml uses these values to create the database.
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pipeline
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://pipeline:change-me@localhost:5432/pipeline

# Extraction (Milestone 3). Defaults shown; override only if needed.
# EXTRACT_MODEL=claude-haiku-5-5
# ESCALATION_MODEL=claude-opus-5-5
# EXTRACT_EFFORT=medium
# CONFIDENCE_THRESHOLD=0.6
# EXTRACT_WORKERS=8
